.claude/story_scope.json
.claude/settings.local.json

# Flex/pairmode runtime (matches flex's own .gitignore convention).
# .companion/ telemetry (effort.db, state.json, pairmode_context.json) is
# rewritten by every build-loop run; tracking it dirties the main checkout and
# makes merge-story-worktree's CER-288 guard refuse every story merge.
.companion/
.pairmode-worktrees/
.pairmode-suggestions.md
.pairmode-review.lck
.pairmode-review-request

# Local settings backups
.claude/*.bak-*

# Deploy target configuration (ssh alias / remote directory) — operator-local, never
# tracked (INFRA-006).
scripts/deploy.env

# release.sh's full stale-claims report (INFRA-021) — local only: forqsite commit
# subjects can name a deployment.
/.release-report.txt
